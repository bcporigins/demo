# ------------------------------------------------------------------
# Notion CMS. Copy to .env.local and fill in.
# Every value is optional: without it the site renders its built-in
# content instead, so you can connect one table at a time.
#
# Fastest path — create a Notion page to hold the tables, connect your
# integration to it (••• → Connections), then run:
#   npm run notion:setup <that-page-url>
# It creates every content table below and prints the ids to paste here.
# ------------------------------------------------------------------

# Integration secret from notion.so/profile/integrations
NOTION_TOKEN=

# --- Blog (also powers "Origin stories" and "Our impact in action" via the
#     post Type column: "Origin Story" / "Impact Story") ---
NOTION_DATABASE_ID=

# --- Careers ---
NOTION_ROLES_DATABASE_ID=
NOTION_APPLICATIONS_DATABASE_ID=

# --- Forms and lists that already existed ---
NOTION_FAQS_DATABASE_ID=
NOTION_HOST_APPS_DATABASE_ID=
NOTION_CONTACT_DATABASE_ID=
NOTION_SUBSCRIBERS_DATABASE_ID=
NOTION_GALLERY_DATABASE_ID=

# --- Editable site content (created by npm run notion:setup) ---
# Core team, regional hosts, advisors, community ambassadors
NOTION_PEOPLE_DATABASE_ID=
# Partner logos
NOTION_PARTNERS_DATABASE_ID=
# The four number tiles on the home page
NOTION_STATS_DATABASE_ID=
NOTION_TESTIMONIALS_DATABASE_ID=
# Flagship + mini experiences; drives the live calendar and Past Events
NOTION_EVENTS_DATABASE_ID=
# Gallery highlights and event recaps (YouTube links)
NOTION_VIDEOS_DATABASE_ID=
# Host resource library, downloads, media kit
NOTION_RESOURCES_DATABASE_ID=
# "Find the right partnership for you" cards
NOTION_PARTNERSHIPS_DATABASE_ID=

# ------------------------------------------------------------------
# Canonical URLs, sitemap, and social share cards. Vercel already sets
# VERCEL_PROJECT_PRODUCTION_URL, so set this only once a custom domain
# is live and should win over the .vercel.app one. No trailing slash.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------
# Links and contact details. Defaults live in lib/site.ts — set these
# only to override without a code change. Set a social to an empty
# value to hide that icon everywhere.
# ------------------------------------------------------------------
NEXT_PUBLIC_BCP_WHATSAPP_URL=
NEXT_PUBLIC_BCP_YOUTUBE_URL=
# Tally (or Google Form / Typeform) host questionnaire, embedded inline on
# /events and /regional-host. Blank falls back to the built-in short form.
NEXT_PUBLIC_BCP_HOST_FORM_URL=
NEXT_PUBLIC_BCP_PHONE_DISPLAY=
NEXT_PUBLIC_BCP_PHONE_TEL=
NEXT_PUBLIC_BCP_FACEBOOK_URL=
NEXT_PUBLIC_BCP_TWITTER_URL=
NEXT_PUBLIC_BCP_INSTAGRAM_URL=
NEXT_PUBLIC_BCP_LINKEDIN_URL=

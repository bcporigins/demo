# Notion CMS — copy to .env.local and fill in to activate the blog.
# Without these the site renders design-placeholder posts.
# Integration secret from notion.so/profile/integrations
NOTION_TOKEN=
# 32-char id from the database URL (or paste the URL into a message and ask
# Claude to extract it). Remember to connect the database to the integration.
NOTION_DATABASE_ID=
# Careers — Job Roles + Applications databases (same integration token)
NOTION_ROLES_DATABASE_ID=
NOTION_APPLICATIONS_DATABASE_ID=
NOTION_ROLES_DATABASE_ID=
NOTION_APPLICATIONS_DATABASE_ID=
NOTION_FAQS_DATABASE_ID=
NOTION_HOST_APPS_DATABASE_ID=
NOTION_CONTACT_DATABASE_ID=
NOTION_SUBSCRIBERS_DATABASE_ID=
NOTION_GALLERY_DATABASE_ID=
